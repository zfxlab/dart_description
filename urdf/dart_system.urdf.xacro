<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dart_system">
  <xacro:include filename="modules/materials.xacro" />
  <xacro:arg name="team" default="red" />
  <xacro:property name="team" value="$(arg team)" />
  <xacro:include filename="modules/field.xacro" />
  <xacro:include filename="modules/bases.xacro" />
  <xacro:include filename="modules/outposts.xacro" />
  <xacro:include filename="modules/dart_stations.xacro" />
  <xacro:include filename="modules/targets.xacro" />
  <xacro:include filename="modules/launcher.xacro" />
  <xacro:include filename="modules/stereo_camera.xacro" />
</robot>