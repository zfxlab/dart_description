<?xml version='1.0' encoding='utf-8'?>
<robot name="stereo_camera">
  <link name="stereo_camera_center_link" />
  <joint name="launcher_to_stereo_camera_center" type="fixed">
    <parent link="launcher_frame" />
    <child link="stereo_camera_center_link" />
    <origin xyz="0.23658 0.0 0.42645" rpy="0.0 0.0 0.0" />
  </joint>
  <link name="left_camera_mount_link">
    <visual>
      <geometry>
        <mesh filename="package://dart_description/meshes/stereo_camera/camera_mount_link_camera.stl" scale="1 1 1" />
      </geometry>
      <material name="camera" />
    </visual>
    <visual>
      <origin xyz="0.012 0.0 0.015" rpy="0.0 0.0 0.0" />
      <geometry>
        <mesh filename="package://dart_description/meshes/stereo_camera/camera_mount_link_lens.stl" scale="1 1 1" />
      </geometry>
      <material name="camera" />
    </visual>
  </link>
  <joint name="stereo_camera_center_to_left_camera_mount" type="fixed">
    <parent link="stereo_camera_center_link" />
    <child link="left_camera_mount_link" />
    <origin xyz="0.0 0.13 0.0" rpy="${-pi / 2} 0.0 0.0" />
  </joint>
  <link name="left_camera_optical_frame" />
  <joint name="left_camera_mount_to_optical" type="fixed">
    <parent link="left_camera_mount_link" />
    <child link="left_camera_optical_frame" />
    <origin xyz="0.04 0.0 0.015" rpy="${-pi / 2} 0.0 ${-pi / 2}" />
  </joint>
  <link name="right_camera_mount_link">
    <visual>
      <geometry>
        <mesh filename="package://dart_description/meshes/stereo_camera/camera_mount_link_camera.stl" scale="1 1 1" />
      </geometry>
      <material name="camera" />
    </visual>
    <visual>
      <origin xyz="0.012 0.0 0.015" rpy="0.0 0.0 0.0" />
      <geometry>
        <mesh filename="package://dart_description/meshes/stereo_camera/camera_mount_link_lens.stl" scale="1 1 1" />
      </geometry>
      <material name="camera" />
    </visual>
  </link>
  <joint name="stereo_camera_center_to_right_camera_mount" type="fixed">
    <parent link="stereo_camera_center_link" />
    <child link="right_camera_mount_link" />
    <origin xyz="0.0 -0.13 0.0" rpy="${pi / 2} 0.0 0.0" />
  </joint>
  <link name="right_camera_optical_frame" />
  <joint name="right_camera_mount_to_optical" type="fixed">
    <parent link="right_camera_mount_link" />
    <child link="right_camera_optical_frame" />
    <origin xyz="0.04 0.0 0.015" rpy="${-pi / 2} 0.0 ${-pi / 2}" />
  </joint>
</robot>